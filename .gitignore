# Rust build output and generated Tauri scaffolding: reproducible from source,
# and target/ is hundreds of megabytes.
app/src-tauri/target/
app/src-tauri/gen/
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/

# macOS
.DS_Store

# Staged into the app by scripts/stage-runtime.py: the CLI's modules, a private
# Windows Python, and the .cmd shims. All reproducible, none of it committed.
app/src-tauri/cli/
app/src-tauri/bin/
app/src-tauri/runtime/
app/src-tauri/.runtime-cache/
