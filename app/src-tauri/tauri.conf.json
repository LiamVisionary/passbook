{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PassBook",
  "mainBinaryName": "passbook-app",
  "version": "1.2.0",
  "identifier": "app.hivemindos.passbook",
  "build": {
    "beforeBuildCommand": "python3 ../scripts/stage-runtime.py",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "publisher": "Rizzma, Inc.",
    "copyright": "Copyright 2026 Rizzma, Inc.",
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "resources": [
      "cli/**/*"
    ],
    "category": "Utility",
    "shortDescription": "The credentials this machine shares",
    "longDescription": "PassBook manages one credential store per machine: which keys are stored, how each one is answered, who has borrowed them, and a tamper-evident record of every read.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "passbook"
        ]
      }
    }
  }
}
