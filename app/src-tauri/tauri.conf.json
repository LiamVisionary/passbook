{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PassBook",
  "mainBinaryName": "passbook-app",
  "version": "1.0.0",
  "identifier": "app.hivemindos.passbook",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "The credentials this machine shares",
    "longDescription": "PassBook manages one credential store per machine: which keys are stored, how each one is answered, who has borrowed them, and a tamper-evident record of every read.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
