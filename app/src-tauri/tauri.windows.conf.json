{
  "build": {
    "beforeBuildCommand": "python ../scripts/stage-runtime.py --runtime"
  },
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "resources": [
      "cli/**/*",
      "runtime/**/*",
      "bin/**/*",
      "nsis/path.ps1"
    ],
    "windows": {
